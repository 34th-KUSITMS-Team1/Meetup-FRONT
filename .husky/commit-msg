# 커밋 컨벤션 검사: <type>: <subject> (.claude/skills/commit/SKILL.md)
first_line=$(head -n 1 "$1")

# git이 자동으로 만드는 메시지는 통과
case "$first_line" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "*) exit 0 ;;
esac

if ! printf '%s\n' "$first_line" | grep -Eq '^(feat|fix|docs|style|refactor|test|chore): [^ ].*[^.]$'; then
  echo "커밋 메시지 형식이 맞지 않습니다: $first_line"
  echo "형식: <type>: <subject>  (type: feat, fix, docs, style, refactor, test, chore)"
  echo "subject는 비우지 않고 마침표로 끝내지 않습니다. 예: feat: 배달 추적 화면 추가"
  exit 1
fi

if grep -Eiq '^(co-authored-by:.*(claude|anthropic|codex|openai)|generated (by|with))' "$1"; then
  echo "AI 출처 문구(Co-Authored-By, Generated by)는 커밋 메시지에 넣지 않습니다."
  exit 1
fi
